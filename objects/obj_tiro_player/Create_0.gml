///@description Configurações iniciais

// Variáveis de velocidade
vel = 10; // Velocidade
velh = 0; // Horizontal
velv = -vel; // Vertical

// Variável que escolhe a cor do tiro
cor = choose(c_aqua, c_red, c_lime, c_white, c_fuchsia, c_yellow);

// Começando o tiro grande
image_xscale = 2;
image_yscale = 3;